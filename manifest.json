{
  "manifest_version": 3,
  "name": "Page Override",
  "version": "0.1.0",
  "description": "Copies the newest downloaded file to a folder and opens it on localhost in the current tab.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+4" },
      "description": "Copy the newest downloaded page override and open it"
    }
  },
  "action": {
    "default_title": "Page Override",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["storage"],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
